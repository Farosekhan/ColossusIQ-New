# "mock" serves /api/v1/* from built-in route handlers with sample data.
# "live" sends requests to NEXT_PUBLIC_API_BASE_URL (your real backend).
NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_API_BASE_URL=

# Signs the session cookie and certificates (both data stores). Use 32+ random chars.
SESSION_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# ── Data store ──────────────────────────────────────────────────────────────
# "memory" (default): the built-in demo data; resets on restart, sign-in accepts any password.
# "postgres": the database in db/ + prisma/ (see docs/database/data-dictionary.md → Running the app).
DATA_BACKEND=memory
# PostgreSQL connection. The Prisma CLI (npm run db:*) reads it from .env, Next.js also from .env.local.
# Connect the app as a login role that is a member of ciq_app (row-level security applies either way).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/collossusiq
# 32+ random characters; encrypts stored authenticator (TOTP) secrets. Needed once any account enrols one.
MFA_ENCRYPTION_KEY=
# Local development only: password that npm run db:dev-accounts sets on every seeded account.
DEV_PASSWORD=
